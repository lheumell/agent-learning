# Clé API Anthropic (pour le "cerveau" de l'agent)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Clé privée du wallet de TEST. Générée par `npm run wallet`. Jamais une clé qui a de vrais fonds.
AGENT_PRIVATE_KEY=

# Réseau : uniquement testnet (le code refuse tout le reste)
RPC_URL=https://sepolia.base.org

# Garde-fous (en ETH de testnet)
MAX_PER_TX_ETH=0.001
MAX_PER_DAY_ETH=0.005
# Adresses autorisées comme destinataires, séparées par des virgules. Vide = toute adresse.
ALLOWED_RECIPIENTS=
# true = simule les transactions sans rien envoyer (recommandé au début)
DRY_RUN=true
